[Desktop Entry]
Version=1.0
Type=Application
Name=Server Manager
GenericName=Multi-Server Management Platform
Comment=Manage servers over SSH with a calm, desktop-native interface

Exec=server_manager %U
Icon=icon-padded
Terminal=false
Categories=Network;System;RemoteAccess;
StartupNotify=true
StartupWMClass=dev.solsynth.maid

# Helps with search in application menus
Keywords=servermanager;ssh;server;remote;maintenance;admin;deploy;shell;terminal;

MimeType=x-scheme-handler/maidkit;
